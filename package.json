{
  "name": "tsmolecules",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.3",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.0.1",
    "@changesets/cli": "^2.29.8",
    "@types/bun": "latest",
    "eslint": "^9.39.2",
    "prettier": "^3.8.0",
    "turbo": "^2.7.4",
    "typescript": "^5.9.3"
  }
}
